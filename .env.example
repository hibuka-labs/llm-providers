# Mimo (TokenPlan) 端到端验证配置
# 复制为 .env 后填入你的真实 API Key
#
# 用法：
#   source .env && cargo run --bin llm-cli -- --message "你好"
#   或
#   dotenv -- cargo run --bin llm-cli -- --message "你好"

LLM_BACKEND=mimo
LLM_MODEL=mimo-v2.5-pro
LLM_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.xiaomimimo.com/anthropic  # 默认值，通常无需填写
