# Local environment for llm-cli / manual verification.
#
# Copy to .env, fill in your real key, then:
#   set -a && source .env && set +a
#   cargo run --bin llm-cli -- --message "hello"
#
# .env is git-ignored — never commit a real key.

LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1

# Optional: force the wire protocol instead of letting the model registry infer it.
# Accepted values: openai | anthropic
# LLM_PROTOCOL=openai

# Other endpoints to try (change base_url + model):
#   Ollama local:  LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:32b
#   DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   Anthropic:     LLM_BASE_URL=https://api.anthropic.com        LLM_MODEL=claude-sonnet-4-20250514
#   Qwen/DashScope: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
